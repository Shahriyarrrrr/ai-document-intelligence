# ---------------------------------------------------------------------------
# Copy to .env and edit. docker-compose overrides the host-specific values.
# ---------------------------------------------------------------------------

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://docint:docint@localhost:5432/docint
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage

# --- LLM extraction --------------------------------------------------------
# With no key the system uses the deterministic rule-based extractor instead
# of failing. That mode is supported, just less accurate - see the evaluation
# report for the measured difference.
LLM_PROVIDER=openai          # openai | anthropic | none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=90

# Pages of a document sent to the LLM. Everything is still indexed for search;
# this only bounds extraction cost on very large PDFs.
LLM_PAGE_BUDGET=8

# --- Semantic search -------------------------------------------------------
# local  = sentence-transformers on CPU (no data leaves the host)
# openai = text-embedding-3-small (uses LLM_API_KEY)
# none   = keyword search only
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Requires the pgvector extension. Set false to run on a stock Postgres;
# search then degrades to keyword-only and reports that in the API response.
VECTOR_ENABLED=true

# --- Ingestion -------------------------------------------------------------
MAX_UPLOAD_MB=100
OCR_CHAR_THRESHOLD=40        # below this many chars, a page is treated as scanned
OCR_DPI=300
OCR_LANG=eng

# --- Validation ------------------------------------------------------------
AMOUNT_TOLERANCE=0.02        # currency rounding slack, in the invoice currency
